p({
  "class": "foam.core.boot.CSpec",
  "name": "aILabDAO",
  "description": "",
  "serve": true,
  "authenticate": true,
  "keywords": [ "aILab" ],
  "serviceScript": """
    return new foam.dao.EasyDAO.Builder(x)
      .setOf(com.foamdev.ailab.AILab.getOwnClassInfo())
      .setPm(true)
      .setSeqNo(true)
      .setAuthorize(false)
      .setJournalType(foam.dao.JournalType.SINGLE_JOURNAL)
      .build();
  """,
  "client": `{"of":"com.foamdev.ailab.AILab"}`
})
